            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.token) {",
                  "        pm.collectionVariables.set(\"token\", response.token);",
                  "        console.log(\"Token saved to collection variable\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
