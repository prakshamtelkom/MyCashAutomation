        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
            <stringProp name="script">// Get Domains (Countries) - Capture first id as ID
pm.test(&quot;Get Domains successful&quot;, function () {
    pm.expect(pm.response.code).to.be.oneOf([200, 201]);
});

if (pm.response.code === 200 || pm.response.code === 201) {
    const response = pm.response.json();
    
    // Handle array response - capture first domain id
    if (Array.isArray(response) &amp;&amp; response.length &gt; 0) {
        if (response[0].id) {
            pm.collectionVariables.set(&quot;ID&quot;, response[0].id.toString());
            console.log(&quot;First Domain ID saved to collection variable: ID = &quot; + response[0].id);
        }
        if (response[0].name) {
            pm.collectionVariables.set(&quot;DomainName&quot;, response[0].name);
            console.log(&quot;First Domain Name saved: &quot; + response[0].name);
        }
    }
    
    // Handle object response with data array
    if (response.data &amp;&amp; Array.isArray(response.data) &amp;&amp; response.data.length &gt; 0) {
        if (response.data[0].id) {
            pm.collectionVariables.set(&quot;ID&quot;, response.data[0].id.toString());
            console.log(&quot;First Domain ID saved to collection variable: ID = &quot; + response.data[0].id);
        }
    }
    
    // Handle single object response
    if (response.id &amp;&amp; !Array.isArray(response)) {
        pm.collectionVariables.set(&quot;ID&quot;, response.id.toString());
        console.log(&quot;Domain ID saved to collection variable: ID = &quot; + response.id);
    }
}

pm.test(&quot;Domain ID captured&quot;, function () {
    const domainId = pm.collectionVariables.get(&quot;ID&quot;);
    if (domainId) {
        pm.expect(domainId).to.not.be.empty;
    }
});</stringProp>
